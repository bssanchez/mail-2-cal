# Copia este archivo a .env y rellénalo. Usa comillas simples si un valor tiene
# caracteres especiales ($, !, espacios...): IMAP_PASSWORD='mi$clave!'

# --- Correo de Hostinger (IMAP) ---
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993
IMAP_USER='tu.nombre@tuempresa.com'
IMAP_PASSWORD=''
# Carpetas a revisar, separadas por comas (por ejemplo INBOX,Junk)
IMAP_FOLDERS=INBOX

# --- Google Calendar ---
# Cliente OAuth tipo "App de escritorio" (ver README)
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''
# Lo rellena automáticamente: python3 scripts/get_google_token.py
GOOGLE_REFRESH_TOKEN=''
# "primary" = tu calendario principal. Recomendado: un calendario aparte, p. ej.
# "Trabajo" (Configuración del calendario > Integrar el calendario > ID del calendario)
GOOGLE_CALENDAR_ID=primary

# --- General ---
# Tu zona horaria (IANA): America/Bogota, America/Mexico_City, Europe/Madrid...
DEFAULT_TIMEZONE=America/Bogota
# Color de los eventos importados (vacío = color del calendario):
# 1 Lavanda, 2 Salvia, 3 Uva, 4 Flamenco, 5 Plátano, 6 Mandarina,
# 7 Pavo real, 8 Grafito, 9 Arándano, 10 Albahaca, 11 Tomate
EVENT_COLOR_ID=7
# Avisos emergentes (en la app, nunca por correo), en minutos antes; vacío = sin avisos
REMINDER_MINUTES=30,1
# En la primera ejecución, cuántos días hacia atrás revisar
BACKFILL_DAYS=30

# --- Despliegue en AWS (solo lo usa deploy.sh) ---
# AWS_REGION=us-east-1
# FUNCTION_NAME=mail2cal
# SCHEDULE='rate(10 minutes)'
